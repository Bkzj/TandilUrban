{
  "name": "propea-group",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/{unit,repository}/**/*.test.ts\"",
    "test:integration": "tsx --test \"tests/integration/**/*.test.ts\"",
    "test:auth-foundation": "tsx --test tests/unit/auth-security.test.ts tests/unit/security-event-repository.test.ts",
    "test:auth-foundation:postgres": "node scripts/rehearse-phase6a.mjs --repositories-only",
    "rehearsal:phase6a": "node scripts/rehearse-phase6a.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "jobs:cloudinary-cleanup": "tsx scripts/process-cloudinary-cleanup.ts",
    "analytics:reconcile": "tsx scripts/reconcile-analytics-counters.ts",
    "release:smoke": "node scripts/release-smoke.mjs",
    "archive:source": "node scripts/create-source-archive.mjs",
    "test:archive": "node scripts/validate-source-archive.mjs",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:restore-cloudinary": "tsx scripts/build-cloudinary-restore-json.ts && prisma db seed",
    "geo:geocode": "node scripts/geocode-education.js",
    "geo:process": "node scripts/process-geo.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.25",
    "lucide-react": "^1.14.0",
    "next": "16.2.12",
    "next-auth": "^4.24.15",
    "pg": "^8.20.0",
    "puppeteer-core": "^25.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tmcw/togeojson": "^7.1.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xmldom/xmldom": "^0.9.10",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "proj4": "^2.20.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wellknown": "^0.5.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
