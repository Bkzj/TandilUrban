# Base de datos (rotar el valor real antes de desplegar)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# URL publica y autenticacion
NEXTAUTH_URL="https://app.example.com"
NEXTAUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
# Requerida solo en despliegues Next.js con varias instancias; Base64 de 32 bytes.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
APP_URL="https://app.example.com"
NEXT_PUBLIC_APP_URL="https://app.example.com"

# URL interna de confianza para Puppeteer. No se deriva de headers HTTP.
APP_INTERNAL_URL="https://app.example.com"
# Origenes HTTPS adicionales, separados por coma, requeridos por imagenes del informe.
PDF_ALLOWED_ORIGINS="https://res.cloudinary.com"
# Habilitar solo si el contenedor/host aporta aislamiento equivalente al sandbox de Chrome.
PUPPETEER_DISABLE_SANDBOX="false"
# PUPPETEER_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"

# Rate limiting compartido. `memory` solo se admite explícitamente en desarrollo local.
RATE_LIMIT_BACKEND="postgresql"
# Definir solo detrás del proxy correspondiente: x-vercel-forwarded-for o cf-connecting-ip.
RATE_LIMIT_TRUSTED_IP_HEADER="x-vercel-forwarded-for"
# HMAC separado para claves anónimas rotativas de visualizaciones (mínimo 32 bytes aleatorios).
VIEW_TRACKING_SECRET="REPLACE_WITH_RANDOM_32_BYTE_SECRET"

# Clave dedicada para cifrar secretos TOTP: Base64 de exactamente 32 bytes.
AUTH_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
AUTH_TOTP_ISSUER="Propea Group"
AUTH_TOTP_CHALLENGE_TTL_SECONDS="300"
AUTH_PASSWORD_RESET_TTL_MINUTES="30"
AUTH_EMAIL_VERIFICATION_TTL_HOURS="24"
AUTH_RECENT_LOGIN_TTL_MINUTES="15"
AUTH_RECOVERY_CODE_COUNT="10"
ACCOUNT_INVITATION_TTL_HOURS="48"

# Gemini
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
GEMINI_MODEL="gemini-model-name"
INVITATION_GEMINI_ENABLED="false"

# Cloudinary
CLOUDINARY_CLOUD_NAME="REPLACE_WITH_CLOUD_NAME"
CLOUDINARY_API_KEY="REPLACE_WITH_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="REPLACE_WITH_CLOUDINARY_API_SECRET"

# Resend
# Default seguro local/CI: no contacta proveedores externos.
EMAIL_PROVIDER="sink"
# En modo sink, configurar un receptor HTTP local de loopback para capturar mensajes.
# AUTH_EMAIL_TEST_SINK_URL="http://127.0.0.1:8025/messages"
# Para QA manual real: EMAIL_PROVIDER="resend", clave válida y remitente de dominio verificado.
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
RESEND_FROM_EMAIL="Propea Group <no-reply@example.com>"
LEAD_NOTIFICATION_TO_EMAIL="operaciones@example.com"
MATCH_NOTIFICATION_TO_EMAIL="operaciones@example.com"
