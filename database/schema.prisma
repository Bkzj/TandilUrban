generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  INMOBILIARIA
  AGENTE
  USUARIO_NORMAL
}

enum EstadoPropiedad {
  DISPONIBLE
  RESERVADA
  VENDIDA
  PAUSADA
}

enum CategoriaPuntoInteres {
  HOSPITAL
  UNIVERSIDAD
  PARADA_BUS
  PARQUE
}

model User {
  id               String     @id @default(cuid())
  rol              RolUsuario @default(USUARIO_NORMAL)
  nombre           String
  email            String     @unique
  passwordHash     String
  telefono         String?
  avatarUrl        String?
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?
  emailVerifiedAt  DateTime?

  // 1-1: el MAIN de la inmobiliaria (único dueño)
  inmobiliariaPerfil Inmobiliaria? @relation("PerfilInmobiliaria")

  // N-1: agentes de una inmobiliaria
  agenciaId String?
  agencia   Inmobiliaria? @relation("AgentesDeInmobiliaria", fields: [agenciaId], references: [id], onDelete: SetNull)

  verificationTokens VerificationToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([agenciaId])
}

model Inmobiliaria {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation("PerfilInmobiliaria", fields: [userId], references: [id], onDelete: Cascade)
  nombreAgencia String
  logoAgencia   String?
  cuit          String  @unique
  direccion     String

  agentes     User[]      @relation("AgentesDeInmobiliaria")
  propiedades Propiedad[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Propiedad {
  id             String       @id @default(cuid())
  inmobiliariaId String
  inmobiliaria   Inmobiliaria @relation(fields: [inmobiliariaId], references: [id], onDelete: Cascade)

  titulo          String
  descripcion     String          @db.Text
  estado          EstadoPropiedad @default(DISPONIBLE)
  tipo            String
  operacion       String
  precio          Float
  moneda          String          @default("USD")
  expensas        Float?
  direccion       String
  barrio          String?
  latitud         Float
  longitud        Float
  m2Total         Float
  m2Cubiertos     Float
  ambientes       Int
  caracteristicas String[]
  imagenes        String[]

  contactos Contacto[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([inmobiliariaId])
  @@index([estado])
  @@index([tipo])
  @@index([operacion])
  @@index([barrio])
}

model Contacto {
  id          String    @id @default(cuid())
  nombre      String
  email       String
  mensaje     String    @db.Text
  propiedadId String
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([propiedadId])
}

model PuntoInteres {
  id        String                @id @default(cuid())
  nombre    String
  categoria CategoriaPuntoInteres
  latitud   Float
  longitud  Float

  @@index([categoria])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
}
